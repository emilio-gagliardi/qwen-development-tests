# Environment Configuration for Docker Deployment

# LiteLLM Gateway (points to sidecar container)
RAG_LITELLM_BASE_URL=http://litellm-proxy:4000
# RAG_LITELLM_API_KEY=sk-1234

# Model Configuration (using model names from litellm_config.yaml)
RAG_FAST_MODEL=fast-model
RAG_BALANCED_MODEL=balanced-model
RAG_ADVANCED_MODEL=advanced-model
RAG_CLASSIFIER_MODEL=fast-model

# Intent Classifier Settings
RAG_CLASSIFIER_TIMEOUT=5.0

# RAG Configuration
RAG_MAX_RETRIEVED_DOCS=5
RAG_MIN_RELEVANCE_SCORE=0.7

# Service Configuration
RAG_SERVICE_NAME=rag-pipeline
RAG_DEBUG=false

# LLM Provider API Keys (only needed by LiteLLM proxy container, not app)
# These are set in docker-compose.yml for the litellm-proxy service
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Langfuse Observability (optional but recommended)
# Set these in docker-compose.yml for the litellm-proxy service
# LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
# LANGFUSE_SECRET_KEY=your-langfuse-secret-key
# LANGFUSE_HOST=https://cloud.langfuse.com

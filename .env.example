# Environment Configuration

# LiteLLM Gateway
RAG_LITELLM_BASE_URL=http://localhost:4000
# RAG_LITELLM_API_KEY=your-litellm-api-key

# Model Configuration (using model names from litellm_config.yaml)
RAG_FAST_MODEL=gpt-3.5-turbo
RAG_BALANCED_MODEL=gpt-4
RAG_ADVANCED_MODEL=gpt-4-turbo
RAG_CLASSIFIER_MODEL=gpt-3.5-turbo

# Intent Classifier Settings
RAG_CLASSIFIER_TIMEOUT=5.0

# RAG Configuration
RAG_MAX_RETRIEVED_DOCS=5
RAG_MIN_RELEVANCE_SCORE=0.7

# Service Configuration
RAG_SERVICE_NAME=rag-pipeline
RAG_DEBUG=false

# LLM Provider API Keys (required for LiteLLM to work)
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# GEMINI_API_KEY=your-gemini-api-key
